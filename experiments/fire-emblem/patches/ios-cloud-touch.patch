+- (void)fePulse:(int)bit {
+    if (!_tap || _padOff) return;
+    NSTimeInterval now = CACurrentMediaTime();
+    if (_gestureReady > now + 0.65) return; // Bound queued actions if the screen is tapped rapidly.
+    NSTimeInterval start = MAX(now, _gestureReady); _gestureReady = start + 0.18;
+    NSUInteger epoch = _gestureEpoch;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((start - now) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        if (self->_gestureEpoch != epoch || !self->_tap || self->_padOff) return;
+        LOG("fire emblem touch gesture: controller button %d", bit);
+        pthread_mutex_lock(&g_mu); g_gesture_btn |= 1ull << bit; pthread_mutex_unlock(&g_mu); publish();
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            if (self->_gestureEpoch != epoch) return;
+            pthread_mutex_lock(&g_mu); g_gesture_btn &= ~(1ull << bit); pthread_mutex_unlock(&g_mu); publish();
+        });
+    });
+}
+- (void)feTap:(UITapGestureRecognizer *)recognizer {
+    if (recognizer.state == UIGestureRecognizerStateRecognized) [self fePulse:recognizer.numberOfTouchesRequired == 2 ? B_B : B_A];
+}
+- (void)feSwipe:(UISwipeGestureRecognizer *)recognizer {
+    if (recognizer.state != UIGestureRecognizerStateRecognized) return;
+    int bit = recognizer.direction == UISwipeGestureRecognizerDirectionUp ? B_UP :
+              recognizer.direction == UISwipeGestureRecognizerDirectionDown ? B_DOWN :
+              recognizer.direction == UISwipeGestureRecognizerDirectionLeft ? B_LEFT : B_RIGHT;
+    [self fePulse:bit];
+}
