+    __block double lastTime = CACurrentMediaTime();
+    self.fpsTimer = [NSTimer scheduledTimerWithTimeInterval:1.0 repeats:YES block:^(NSTimer *timer) {
+        uint64_t count = mtl_present_count();
+        double now = CACurrentMediaTime();
