+static inline void botw_center_crop(size_t *x, size_t *y, size_t *w, size_t *h,
+                                    size_t out_w, size_t out_h) {
+    if (!out_w || !out_h || !*w || !*h) return;
+    if (*w * out_h > *h * out_w) {
+        size_t new_w = *h * out_w / out_h;
