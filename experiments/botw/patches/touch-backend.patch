+    if (!size || offset > SIZE_MAX - (size - 1)) return false;
+    size_t first = offset / 4096, last = (offset + size - 1) / 4096;
+    if (last >= page_count) return false;
+    for (size_t page = first; page <= last; page++)
+        if (!pages[page]) return false;
+    return true;
+}
